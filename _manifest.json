{
  "manifest_version": 2,
  "id": "rainbear.mai-offline-bell",
  "name": "麦麦掉线铃",
  "version": "0.2.0",
  "description": "定时查询 OneBot 11 客户端（NapCat、SnowLuma 等）报告的 QQ 在线状态，通过 Server 酱、PushPlus、飞书、钉钉或 Bark 发送掉线、探测异常和恢复通知。",
  "author": {"name": "rainbear", "url": "https://github.com/gouduyao"},
  "urls": {"repository": "https://github.com/gouduyao/mai-offline-bell"},
  "license": "MIT",
  "plugin_type": "integration",
  "host_application": {"min_version": "1.4.8", "max_version": "1.4.99"},
  "sdk": {"min_version": "2.23.0", "max_version": "2.23.99"},
  "changelog": "CHANGELOG.md",
  "dependencies": [{"type": "python_package", "name": "aiohttp", "version_spec": ">=3.10,<4"}],
  "capabilities": [],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
